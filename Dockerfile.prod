FROM node:24-slim AS builder
WORKDIR /app
COPY app/package*.json ./
RUN npm install
COPY app/ .

ENV NODE_OPTIONS="--max-old-space-size=1024"

RUN npx vite build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html

RUN mkdir -p /var/www/certbot

EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
